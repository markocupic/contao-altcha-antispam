<?php $this->block('altcha_script'); ?>
<?php if ('cdn' === $this->altchaSource): ?>
    <?php $GLOBALS['TL_HEAD'][] = '<script async defer src="https://cdn.jsdelivr.net/npm/altcha@2.2.4/dist/altcha.js" type="module"></script>'; ?>
<?php else: ?>
    <?php $GLOBALS['TL_STYLE_SHEETS']['markocupic_contao_altcha_antispam_stylesheet'] = '<link rel="stylesheet" href="' . \Contao\System::getContainer()->get('assets.packages')->getUrl('altcha/dist_external/altcha.css', 'markocupic_contao_altcha_antispam') . '">'; ?>
    <?php $GLOBALS['TL_HEAD']['markocupic_contao_altcha_antispam_script'] = '<script async defer src="' . \Contao\System::getContainer()->get('assets.packages')->getUrl('altcha/dist_external/altcha.js', 'markocupic_contao_altcha_antispam') . '" type="module"></script>'; ?>
<?php endif; ?>
<?php $this->endblock(); ?>
<?= $this->honeypot ?>
<div class="<?= $this->prefix ?><?php if ($this->class): ?> <?= $this->class ?><?php endif; ?>">
    <?php $this->block('label'); ?>
    <?php if ($this->label): ?>
        <label for="ctrl_<?= $this->id ?>"<?php if ($this->class): ?> class="<?= $this->class ?>"<?php endif; ?>>
    <?= $this->label ?>
    </label>
    <?php endif; ?>
    <?php $this->endblock(); ?>

    <?php $this->block('field'); ?>
    <?php if ($this->hasErrors()): ?>
        <p class="error"><?= $this->getErrorAsString() ?></p>
    <?php endif; ?>

    <?php $this->block('altcha_tag'); ?>
    <altcha-widget<?= $this->altchaAttributes ?>></altcha-widget>
    <?php $this->endblock(); ?>
    <?php $this->endblock(); ?>
</div>
