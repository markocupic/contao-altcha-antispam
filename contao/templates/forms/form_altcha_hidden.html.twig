{% block altcha_script %}
    {% if altchaSource == 'cdn' %}
        {# Allow the CDN if the Contao Content Security Policy is enabled #}
        {% do csp_source('script-src', 'https://cdn.jsdelivr.net') %}
        {% add 'markocupic_contao_altcha_antispam_script' to head %}
            <script async src="https://cdn.jsdelivr.net/npm/altcha@2.2.4/dist/altcha.js" type="module"></script>
        {% endadd %}
    {% else %}
        {# The "external" build does not inject inline styles and does not use blob: workers (CSP compatible) #}
        {% add 'markocupic_contao_altcha_antispam_stylesheet' to stylesheets %}
            <link rel="stylesheet" href="{{ asset('altcha/dist_external/altcha.css', 'markocupic_contao_altcha_antispam') }}">
        {% endadd %}
        {% add 'markocupic_contao_altcha_antispam_script' to head %}
            <script async src="{{ asset('altcha/dist_external/altcha.js', 'markocupic_contao_altcha_antispam') }}" type="module"></script>
        {% endadd %}
    {% endif %}
{% endblock %}
{{ honeypot|raw }}
<div class="{{ prefix }}{% if strClass|default %} {{ strClass }}{% endif %}">
    {% block label %}
        {% if strLabel|default %}
            <label for="ctrl_{{ strId }}" {% if strClass|default %} class="{{ strClass }}" {% endif %}>
                {{ strLabel }}
            </label>
        {% endif %}
    {% endblock %}
    {% block field %}
        {% if hasErrors.invoke()|default(false) %}
            <p class="error">{{ getErrorAsString.invoke()|default('')|raw }}</p>
        {% endif %}
        {% block altcha_tag %}
            {# The ALTCHA widget can be customized:
            {% set altchaAttributes = altchaAttributes
                .unset('bar')
                .add('foo', 'bar') %}
            #}
            <altcha-widget{{ altchaAttributes|raw }}></altcha-widget>
        {% endblock %}
    {% endblock %}
</div>
